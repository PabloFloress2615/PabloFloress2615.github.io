---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  /** Prefix for the header's in-page anchors; '/' on sub-pages. */
  anchorPrefix?: string;
}

const { title, description, image, type, anchorPrefix } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Pablo Flores" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1115" media="(prefers-color-scheme: dark)" />

    <Seo title={title} description={description} image={image} type={type} />

    {/*
      Applies the stored theme before first paint so there is no flash of the
      wrong palette. It must be inline and blocking; a bundled/deferred script
      would run too late. Storage access is wrapped because it throws in
      private-mode and blocked-cookie browsers.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) {
          /* No persisted preference available; prefers-color-scheme decides. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header anchorPrefix={anchorPrefix} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');

      const resolved = (): 'dark' | 'light' => {
        if (root.dataset.theme === 'dark' || root.dataset.theme === 'light') {
          return root.dataset.theme;
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const sync = () => {
        const isDark = resolved() === 'dark';
        toggle?.setAttribute('aria-pressed', String(isDark));
        toggle?.setAttribute(
          'aria-label',
          isDark ? 'Switch to light theme' : 'Switch to dark theme',
        );
      };

      toggle?.addEventListener('click', () => {
        const next = resolved() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {
          /* Preference simply will not persist across reloads. */
        }
        sync();
      });

      // Track the OS preference while no explicit choice has been pinned.
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', () => {
          if (!root.dataset.theme) sync();
        });

      sync();
    </script>
  </body>
</html>
