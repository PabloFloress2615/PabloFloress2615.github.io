---
import { isPlaceholder, type Certification } from '../data/site';

interface Props {
  items: readonly Certification[];
  /** Smaller badges, for the secondary training list. */
  compact?: boolean;
}

const { items, compact = false } = Astro.props;
---

<ul class:list={['certs', compact && 'certs--compact']}>
  {
    items.map((cert) => {
      const linked = !isPlaceholder(cert.href);
      const Tag = linked ? 'a' : 'div';
      return (
        <li class="certs__item">
          <Tag
            class:list={['certs__card', linked && 'certs__card--linked']}
            {...(linked ? { href: cert.href, rel: 'noopener', target: '_blank' } : {})}
          >
            {cert.badge ? (
              <img
                class="certs__badge-img"
                src={cert.badge}
                alt=""
                width="320"
                height="320"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="certs__badge-img certs__badge-img--empty" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="9" r="6" />
                  <path d="M8.5 14.5 7 22l5-2.5L17 22l-1.5-7.5" stroke-linejoin="round" />
                </svg>
              </div>
            )}

            <p class="certs__name">
              {cert.name}
              {linked && <span class="visually-hidden"> — view credential (opens in a new tab)</span>}
            </p>
            <p class="certs__issuer">{cert.issuer}</p>

            {cert.inProgress && <span class="certs__state">In progress</span>}
            {!linked && !cert.inProgress && <span class="certs__state certs__state--todo">TODO: add URL</span>}
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  /* Fixed column counts rather than auto-fill: the eight certifications then
     land as two even rows of four instead of a ragged 6 + 2. */
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4) var(--space-2);
  }

  @media (min-width: 34rem) {
    .certs {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .certs {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5) var(--space-4);
    }
  }

  .certs__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4) var(--space-2);
    text-align: center;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition: border-color 120ms ease, background-color 120ms ease;
  }

  .certs__card--linked:hover {
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  .certs__badge-img {
    width: 100%;
    max-width: 6.25rem;
    height: auto;
    aspect-ratio: 1;
  }

  /* Credentials with no badge art still occupy the same footprint, so the grid
     does not jump between rows. */
  .certs__badge-img--empty {
    display: grid;
    place-items: center;
    color: var(--color-border-strong);
    border: 1px dashed var(--color-border-strong);
    border-radius: 50%;
  }

  .certs__badge-img--empty svg {
    width: 44%;
    height: 44%;
  }

  .certs__name {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .certs__card--linked:hover .certs__name {
    color: var(--color-accent);
  }

  .certs__issuer {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .certs__state {
    margin-top: auto;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-2);
  }

  .certs__state--todo {
    font-family: var(--font-mono);
    border-style: dashed;
    border-color: var(--color-border-strong);
  }

  /* Secondary list: same grid, smaller artwork and type, so it reads as
     supporting evidence rather than competing with the certifications. */
  .certs--compact .certs__badge-img {
    max-width: 4rem;
  }

  .certs--compact .certs__name {
    font-size: var(--text-xs);
    font-weight: 550;
  }

  .certs--compact .certs__card {
    padding-block: var(--space-3);
  }

  @media (min-width: 48rem) {
    .certs--compact {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
