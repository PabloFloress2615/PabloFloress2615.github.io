---
interface Props {
  href: string;
  title: string;
  summary: string;
  clientDescriptor: string;
  stack: readonly string[];
}

const { href, title, summary, clientDescriptor, stack } = Astro.props;

// Cards show a few representative technologies; the full list lives on the page.
const shown = stack.slice(0, 4);
---

<li class="card card--linked">
  <p class="card__client">{clientDescriptor}</p>
  <h3 class="card__title">
    <a class="card__link" href={href}>{title}</a>
  </h3>
  <p class="card__summary">{summary}</p>
  <ul class="tags" aria-label="Technologies">
    {shown.map((item) => <li class="tags__item">{item}</li>)}
    {stack.length > shown.length && <li class="tags__item">+{stack.length - shown.length}</li>}
  </ul>
  <p class="card__cta" aria-hidden="true">Read case study &rarr;</p>
</li>
