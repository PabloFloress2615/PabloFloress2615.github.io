---
import { site, links, isPlaceholder } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Overrides the default social card. Path relative to the site root. */
  image?: string;
  /** Case study pages are articles; the home page is a profile page. */
  type?: 'website' | 'article';
}

const { title, description, image = site.ogImage, type = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

// Placeholder URLs must never reach structured data — a broken `sameAs` is
// worse for SEO than an absent one.
const sameAs = [links.github, links.linkedin, links.credly].filter((url) => !isPlaceholder(url));

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  description: site.about,
  email: `mailto:${site.email}`,
  url: Astro.site?.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guatemala City',
    addressCountry: 'GT',
  },
  knowsAbout: [
    'Cloud infrastructure',
    'Infrastructure as code',
    'Terraform',
    'Kubernetes',
    'Observability',
    'Site reliability engineering',
  ],
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(personSchema)}
/>
